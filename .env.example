# Environment variables template for SpeederSpider
# Copy to .env.local and fill in the values with actual credentials.
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL.

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Replace with your Supabase Project URL from project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Replace with your Supabase Anon/Public Key from project settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Replace with your Supabase Service Role Key (SERVER-ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# -----------------------------------------------------------------------------
# Public Website Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_PHONE=0565694440
NEXT_PUBLIC_BUSINESS_PHONE_INTL=+971565694440
NEXT_PUBLIC_BUSINESS_LAT=25.140657502467402
NEXT_PUBLIC_BUSINESS_LNG=55.24151547185268

# -----------------------------------------------------------------------------
# Email Notification Configuration (Resend)
# -----------------------------------------------------------------------------
# API key from resend.com for transactional contact form emails
RESEND_API_KEY=re_your_api_key_here

# Verified sending email address
NOTIFICATIONS_FROM_EMAIL=enquiries@speederspider.com

# Destination email for new contact enquiries
CONTACT_NOTIFICATION_EMAIL=info@speederspider.com
